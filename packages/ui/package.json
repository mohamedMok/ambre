      "types": "./types/index.d.ts",
      "import": "./dist/dialog.js"
    },
    "./menu": {
      "types": "./types/index.d.ts",
      "import": "./dist/menu.js"
    },
    "./pagination": {
      "types": "./types/index.d.ts",
      "import": "./dist/pagination.js"
    },
    "./progress": {
      "types": "./types/index.d.ts",
      "import": "./dist/progress.js"
    },
    "./range": {
      "types": "./types/index.d.ts",
      "import": "./dist/range.js"
    },
    "./skeleton": {
      "types": "./types/index.d.ts",
      "import": "./dist/skeleton.js"
    },
    "./spinner": {
      "types": "./types/index.d.ts",
      "import": "./dist/spinner.js"
