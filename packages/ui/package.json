      "types": "./types/index.d.ts",
      "import": "./dist/icon.js"
    },
    "./checkbox": {
      "types": "./types/index.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./link": {
      "types": "./types/index.d.ts",
      "import": "./dist/link.js"
    },
    "./radio": {
      "types": "./types/index.d.ts",
      "import": "./dist/radio.js"
    },
    "./select": {
      "types": "./types/index.d.ts",
      "import": "./dist/select.js"
    },
    "./badge": {
      "types": "./types/index.d.ts",
      "import": "./dist/badge.js"
    },
    "./banner": {
      "types": "./types/index.d.ts",
