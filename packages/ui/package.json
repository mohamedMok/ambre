{
  "name": "@ambre-ds/ui",
  "version": "0.1.0",
  "description": "Ambre web components: accessible custom elements (amb-*) that work in any framework and follow any brand preset.",
  "keywords": [
    "design-system",
    "web-components",
    "custom-elements",
    "accessibility",
    "wcag",
    "svelte",
    "ambre"
  ],
  "homepage": "https://mohamedmok-ambre.surge.sh/components",
  "bugs": "https://github.com/mohamedMok/ambre/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedMok/ambre.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "type": "module",
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "types",
    "custom-elements.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "./dist/*.js"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./types/index.d.ts",
      "import": "./dist/button.js"
    },
    "./disclosure": {
      "types": "./types/index.d.ts",
      "import": "./dist/disclosure.js"
    },
