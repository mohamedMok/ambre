{
  "name": "@ambre/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Ambre web components. One library, custom elements prefixed amb-.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "types",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/*.js"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./types/index.d.ts",
      "import": "./dist/button.js"
    },
    "./disclosure": {
      "types": "./types/index.d.ts",
      "import": "./dist/disclosure.js"
    },
    "./icon": {
      "types": "./types/index.d.ts",
      "import": "./dist/icon.js"
    },
    "./checkbox": {
      "types": "./types/index.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./link": {
      "types": "./types/index.d.ts",
      "import": "./dist/link.js"
    },
    "./radio": {
      "types": "./types/index.d.ts",
      "import": "./dist/radio.js"
    },
    "./select": {
      "types": "./types/index.d.ts",
      "import": "./dist/select.js"
    },
    "./badge": {
      "types": "./types/index.d.ts",
      "import": "./dist/badge.js"
    },
    "./banner": {
      "types": "./types/index.d.ts",
      "import": "./dist/banner.js"
    },
    "./breadcrumbs": {
      "types": "./types/index.d.ts",
      "import": "./dist/breadcrumbs.js"
    },
    "./dialog": {
      "types": "./types/index.d.ts",
      "import": "./dist/dialog.js"
    },
    "./menu": {
      "types": "./types/index.d.ts",
      "import": "./dist/menu.js"
    },
    "./pagination": {
      "types": "./types/index.d.ts",
      "import": "./dist/pagination.js"
    },
    "./progress": {
      "types": "./types/index.d.ts",
      "import": "./dist/progress.js"
    },
    "./range": {
      "types": "./types/index.d.ts",
      "import": "./dist/range.js"
    },
    "./skeleton": {
      "types": "./types/index.d.ts",
      "import": "./dist/skeleton.js"
    },
    "./spinner": {
      "types": "./types/index.d.ts",
      "import": "./dist/spinner.js"
    },
    "./tabs": {
      "types": "./types/index.d.ts",
      "import": "./dist/tabs.js"
    },
    "./tag": {
      "types": "./types/index.d.ts",
      "import": "./dist/tag.js"
    },
    "./text-area": {
      "types": "./types/index.d.ts",
      "import": "./dist/text-area.js"
    },
    "./text-field": {
      "types": "./types/index.d.ts",
      "import": "./dist/text-field.js"
    },
    "./toggle": {
      "types": "./types/index.d.ts",
      "import": "./dist/toggle.js"
    },
    "./tooltip": {
      "types": "./types/index.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "scripts": {
    "build": "node ../../scripts/build-manifest.mjs && vite build",
    "test": "node ../../scripts/build-manifest.mjs && node ../../scripts/check-contract.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@ambre/tokens": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.6",
    "sass-embedded": "^1.105.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
}
