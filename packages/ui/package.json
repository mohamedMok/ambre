      "import": "./dist/tile.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/build-manifest.mjs && vite build",
    "test": "node ../../scripts/build-manifest.mjs && node ../../scripts/check-contract.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@ambre-ds/tokens": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.6",
    "sass-embedded": "^1.105.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.3",
