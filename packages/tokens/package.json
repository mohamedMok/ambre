{
  "name": "@ambre-ds/tokens",
  "version": "0.3.0",
  "description": "Ambre design tokens: DTCG sources compiled to CSS custom properties, Sass variables, JSON, and brand presets.",
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "css-variables",
    "theming",
    "ambre"
  ],
  "homepage": "https://mohamedmok-ambre.surge.sh/foundations",
  "bugs": "https://github.com/mohamedMok/ambre/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedMok/ambre.git",
    "directory": "packages/tokens"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "types.d.ts"
  ],
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/tokens.css",
    "./css/presets": "./dist/css/presets.css",
    "./scss": "./dist/scss/_tokens.scss",
    "./scss/dark": "./dist/scss/_tokens-dark.scss",
    "./json": "./dist/json/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.js",
    "test": "node build.js && node scripts/contrast.mjs",
    "prepack": "node build.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "style-dictionary": "^5.5.5"
  }
}
