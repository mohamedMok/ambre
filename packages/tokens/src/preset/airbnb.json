{
  "name": "Airbnb",
  "description": "Nunito Sans, 8px actions and fields, warm neutral surfaces. The action fill is #d70466 rather than #ff385c so white labels meet WCAG AA. Load Nunito Sans in the product. Cereal is not shipped.",
  "shared": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": [
            "Nunito Sans",
            "Segoe UI",
            "sans-serif"
          ],
          "$description": "UI text. Nunito Sans is the open-license face. Load it in the product."
        }
      },
      "lineHeight": {
        "tight": {
          "$type": "number",
          "$value": 1.2,
          "$description": "Controls and headings."
        }
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$description": "Tight corner. 4px."
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "Default control corner. 8px."
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Large surface corner. 16px."
      },
      "action": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "Action corner. 8px."
      }
    }
  },
  "light": {
    "color": {
      "bg": {
        "canvas": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Page background."
        },
        "surface": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Cards, fields, and secondary buttons."
        },
        "subtle": {
          "$type": "color",
          "$value": "#f7f7f7",
          "$description": "Hover fill for quiet controls."
        },
        "muted": {
          "$type": "color",
          "$value": "#ebebeb",
          "$description": "Pressed fill for quiet controls."
        },
        "inverse": {
          "$type": "color",
          "$value": "#222222",
          "$description": "Inverted surface."
        },
        "disabled": {
          "$type": "color",
          "$value": "#f7f7f7",
          "$description": "Disabled control fill."
        }
      },
      "fg": {
        "default": {
          "$type": "color",
          "$value": "#222222",
          "$description": "Default text."
        },
        "muted": {
          "$type": "color",
          "$value": "#6a6a6a",
          "$description": "Secondary text."
        },
        "subtle": {
          "$type": "color",
          "$value": "#767676",
          "$description": "Tertiary text. Still meets AA on the canvas."
        },
        "inverse": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Text on an inverted surface."
        },
        "on-accent": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Text on an accent fill."
        },
        "disabled": {
          "$type": "color",
          "$value": "#767676",
          "$description": "Disabled control text. Disabled text is exempt from WCAG contrast, and this pair stays visible."
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "#767676",
          "$description": "UI boundary. Meets 3:1 against the canvas."
        },
        "strong": {
          "$type": "color",
          "$value": "#222222",
          "$description": "Emphasis boundary."
        },
        "disabled": {
          "$type": "color",
          "$value": "#dddddd",
          "$description": "Disabled control boundary."
        }
      },
      "accent": {
        "bg": {
          "$type": "color",
          "$value": "#d70466",
          "$description": "Primary action fill."
        },
        "bg-hover": {
          "$type": "color",
          "$value": "#bd1e59",
          "$description": "Primary action hover fill."
        },
        "bg-active": {
          "$type": "color",
          "$value": "#a1123a",
          "$description": "Primary action pressed fill."
        },
        "fg": {
          "$type": "color",
          "$value": "#d70466",
          "$description": "Accent text, including links and ghost controls."
        }
      },
      "focus": {
        "ring": {
          "$type": "color",
          "$value": "#d70466",
          "$description": "Focus ring. Meets 3:1 against the canvas and surfaces."
        }
      },
      "status": {
        "danger": {
          "fg": {
            "$type": "color",
            "$value": "#c13515",
            "$description": "Danger text on the canvas."
          },
          "bg": {
            "$type": "color",
            "$value": "#c13515",
            "$description": "Danger fill."
          },
          "on": {
            "$type": "color",
            "$value": "#ffffff",
            "$description": "Text on a danger fill."
          }
        },
        "success": {
          "fg": {
            "$type": "color",
            "$value": "#067647",
            "$description": "Success text on the canvas."
          },
          "bg": {
            "$type": "color",
            "$value": "#067647",
            "$description": "Success fill."
          },
          "on": {
            "$type": "color",
            "$value": "#ffffff",
            "$description": "Text on a success fill."
          }
        }
      }
    },
    "elevation": {
      "1": {
        "$type": "shadow",
        "$value": "0px 1px 2px 0px rgb(0 0 0 / 0.08)",
        "$description": "Raised control."
      },
      "2": {
        "$type": "shadow",
        "$value": "0px 6px 16px 0px rgb(0 0 0 / 0.12)",
        "$description": "Dropdown and popover."
      },
      "3": {
        "$type": "shadow",
        "$value": "0px 8px 28px 0px rgb(0 0 0 / 0.16)",
        "$description": "Dialog and overlay."
      }
    }
  },
