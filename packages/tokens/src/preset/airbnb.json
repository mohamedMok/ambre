{
  "name": "Airbnb",
  "description": "Nunito Sans at 700, 16px actions, 12px fields, 2px borders, taller controls. The action fill is #d70466 rather than #ff385c so white labels meet WCAG AA. Load Nunito Sans in the product. Cereal is not shipped.",
  "shared": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": ["Nunito Sans", "Segoe UI", "sans-serif"],
          "$description": "UI text. Nunito Sans is the open-license face. Load it in the product."
        },
        "mono": {
          "$type": "fontFamily",
          "$value": ["ui-monospace", "monospace"],
          "$description": "Code and token names."
        }
      },
      "weight": {
        "regular": { "$type": "fontWeight", "$value": 400, "$description": "Body text." },
        "medium": { "$type": "fontWeight", "$value": 600, "$description": "Emphasis inside body text." },
        "semibold": { "$type": "fontWeight", "$value": 700, "$description": "Controls and headings." }
      },
      "lineHeight": {
        "tight": { "$type": "number", "$value": 1.25, "$description": "Controls and headings." },
        "body": { "$type": "number", "$value": 1.5, "$description": "Paragraphs." },
        "loose": { "$type": "number", "$value": 1.65, "$description": "Long reading text." }
      },
      "size": {
        "100": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "Caption." },
        "200": { "$type": "dimension", "$value": { "value": 14, "unit": "px" }, "$description": "Compact control." },
        "300": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Body and default control." },
        "400": { "$type": "dimension", "$value": { "value": 18, "unit": "px" }, "$description": "Large control and lead-in." },
        "500": { "$type": "dimension", "$value": { "value": 22, "unit": "px" }, "$description": "Title small." },
        "600": { "$type": "dimension", "$value": { "value": 26, "unit": "px" }, "$description": "Title." },
        "700": { "$type": "dimension", "$value": { "value": 32, "unit": "px" }, "$description": "Title large." },
        "800": { "$type": "dimension", "$value": { "value": 44, "unit": "px" }, "$description": "Display small." },
        "900": { "$type": "dimension", "$value": { "value": 52, "unit": "px" }, "$description": "Display." }
      }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": { "value": 8, "unit": "px" }, "$description": "Tight corner. 8px." },
      "md": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "Default control corner. 12px." },
      "lg": { "$type": "dimension", "$value": { "value": 24, "unit": "px" }, "$description": "Large surface corner. 24px." },
      "action": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Action corner. 16px." }
    },
    "border": {
      "width": {
        "default": { "$type": "dimension", "$value": { "value": 2, "unit": "px" }, "$description": "Default stroke." },
        "strong": { "$type": "dimension", "$value": { "value": 2, "unit": "px" }, "$description": "Emphasis stroke." }
      }
    },
    "size": {
      "control": {
        "sm": { "$type": "dimension", "$value": { "value": 40, "unit": "px" }, "$description": "Compact control height." },
        "md": { "$type": "dimension", "$value": { "value": 48, "unit": "px" }, "$description": "Default control height." },
        "lg": { "$type": "dimension", "$value": { "value": 56, "unit": "px" }, "$description": "Large control height." }
      },
      "icon": {
        "sm": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Icon in a compact control." },
        "md": { "$type": "dimension", "$value": { "value": 20, "unit": "px" }, "$description": "Icon in a default control." },
        "lg": { "$type": "dimension", "$value": { "value": 24, "unit": "px" }, "$description": "Icon in a large control." }
      }
    },
    "space": {
      "0": { "$type": "dimension", "$value": { "value": 0, "unit": "px" }, "$description": "Space 0." },
      "100": { "$type": "dimension", "$value": { "value": 4, "unit": "px" }, "$description": "Space 100." },
      "200": { "$type": "dimension", "$value": { "value": 8, "unit": "px" }, "$description": "Space 200." },
      "300": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "Space 300." },
      "400": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Space 400." },
      "500": { "$type": "dimension", "$value": { "value": 20, "unit": "px" }, "$description": "Space 500." },
      "600": { "$type": "dimension", "$value": { "value": 28, "unit": "px" }, "$description": "Space 600." },
      "700": { "$type": "dimension", "$value": { "value": 40, "unit": "px" }, "$description": "Space 700." },
      "800": { "$type": "dimension", "$value": { "value": 56, "unit": "px" }, "$description": "Space 800." },
      "900": { "$type": "dimension", "$value": { "value": 80, "unit": "px" }, "$description": "Space 900." }
    },
    "focus": {
      "ring": {
        "width": { "$type": "dimension", "$value": { "value": 2, "unit": "px" }, "$description": "Focus ring thickness." },
        "offset": { "$type": "dimension", "$value": { "value": 3, "unit": "px" }, "$description": "Space between the control and the focus ring." }
      }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "180ms", "$description": "Hover and press." },
      "moderate": { "$type": "duration", "$value": "240ms", "$description": "Default transition." },
      "slow": { "$type": "duration", "$value": "360ms", "$description": "Large surface enter and exit." }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1], "$description": "Default easing." },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1], "$description": "Elements leaving." }
    }
  },
  "light": {
    "color": {
      "bg": {
        "canvas": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Page background."
        },
        "surface": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Cards, fields, and secondary buttons."
        },
        "subtle": {
          "$type": "color",
          "$value": "#f7f7f7",
          "$description": "Hover fill for quiet controls."
        },
        "muted": {
          "$type": "color",
          "$value": "#ebebeb",
          "$description": "Pressed fill for quiet controls."
        },
        "inverse": {
          "$type": "color",
          "$value": "#222222",
          "$description": "Inverted surface."
        },
        "disabled": {
          "$type": "color",
          "$value": "#f7f7f7",
          "$description": "Disabled control fill."
        }
      },
      "fg": {
        "default": {
          "$type": "color",
          "$value": "#222222",
          "$description": "Default text."
        },
        "muted": {
          "$type": "color",
          "$value": "#6a6a6a",
          "$description": "Secondary text."
        },
        "subtle": {
          "$type": "color",
          "$value": "#767676",
          "$description": "Tertiary text. Still meets AA on the canvas."
        },
        "inverse": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Text on an inverted surface."
        },
        "on-accent": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Text on an accent fill."
        },
        "disabled": {
          "$type": "color",
          "$value": "#767676",
          "$description": "Disabled control text. Disabled text is exempt from WCAG contrast, and this pair stays visible."
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "#767676",
          "$description": "UI boundary. Meets 3:1 against the canvas."
        },
        "strong": {
          "$type": "color",
          "$value": "#222222",
          "$description": "Emphasis boundary."
        },
        "disabled": {
          "$type": "color",
          "$value": "#dddddd",
          "$description": "Disabled control boundary."
        }
      },
      "accent": {
        "bg": {
          "$type": "color",
          "$value": "#d70466",
          "$description": "Primary action fill."
        },
        "bg-hover": {
          "$type": "color",
          "$value": "#bd1e59",
          "$description": "Primary action hover fill."
        },
        "bg-active": {
          "$type": "color",
          "$value": "#a1123a",
          "$description": "Primary action pressed fill."
        },
        "fg": {
          "$type": "color",
          "$value": "#d70466",
          "$description": "Accent text, including links and ghost controls."
        }
      },
      "focus": {
        "ring": {
          "$type": "color",
          "$value": "#d70466",
          "$description": "Focus ring. Meets 3:1 against the canvas and surfaces."
        }
      },
      "status": {
        "danger": {
          "fg": {
            "$type": "color",
            "$value": "#c13515",
            "$description": "Danger text on the canvas."
          },
          "bg": {
            "$type": "color",
            "$value": "#c13515",
            "$description": "Danger fill."
          },
          "on": {
            "$type": "color",
            "$value": "#ffffff",
            "$description": "Text on a danger fill."
          }
        },
        "success": {
          "fg": {
            "$type": "color",
            "$value": "#067647",
            "$description": "Success text on the canvas."
          },
          "bg": {
            "$type": "color",
            "$value": "#067647",
            "$description": "Success fill."
          },
          "on": {
            "$type": "color",
            "$value": "#ffffff",
            "$description": "Text on a success fill."
          }
        }
      }
    },
    "elevation": {
      "1": {
        "$type": "shadow",
        "$value": "0px 1px 2px 0px rgb(0 0 0 / 0.08)",
        "$description": "Raised control."
      },
      "2": {
        "$type": "shadow",
        "$value": "0px 6px 16px 0px rgb(0 0 0 / 0.12)",
        "$description": "Dropdown and popover."
      },
      "3": {
        "$type": "shadow",
        "$value": "0px 8px 28px 0px rgb(0 0 0 / 0.16)",
        "$description": "Dialog and overlay."
      }
    }
  },
  "dark": {
    "color": {
      "bg": {
        "canvas": {
          "$type": "color",
          "$value": "#121212",
          "$description": "Page background."
        },
        "surface": {
          "$type": "color",
          "$value": "#222222",
          "$description": "Cards, fields, and secondary buttons."
        },
        "subtle": {
          "$type": "color",
          "$value": "#2a2a2a",
          "$description": "Hover fill for quiet controls."
        },
        "muted": {
          "$type": "color",
          "$value": "#3f3f3f",
          "$description": "Pressed fill for quiet controls."
        },
        "inverse": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Inverted surface."
        },
        "disabled": {
          "$type": "color",
          "$value": "#2a2a2a",
          "$description": "Disabled control fill."
        }
      },
      "fg": {
        "default": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Default text."
        },
        "muted": {
          "$type": "color",
          "$value": "#dddddd",
          "$description": "Secondary text."
        },
        "subtle": {
          "$type": "color",
          "$value": "#b0b0b0",
          "$description": "Tertiary text. Still meets AA on the canvas."
        },
        "inverse": {
          "$type": "color",
          "$value": "#222222",
          "$description": "Text on an inverted surface."
        },
        "on-accent": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Text on an accent fill."
        },
        "disabled": {
          "$type": "color",
          "$value": "#a3a3a3",
          "$description": "Disabled control text. Disabled text is exempt from WCAG contrast, and this pair stays visible."
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "#8a8a8a",
          "$description": "UI boundary. Meets 3:1 against the canvas."
        },
        "strong": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Emphasis boundary."
        },
        "disabled": {
          "$type": "color",
          "$value": "#3f3f3f",
          "$description": "Disabled control boundary."
        }
      },
      "accent": {
        "bg": {
          "$type": "color",
          "$value": "#d70466",
          "$description": "Primary action fill."
        },
        "bg-hover": {
          "$type": "color",
          "$value": "#bd1e59",
          "$description": "Primary action hover fill."
        },
        "bg-active": {
          "$type": "color",
          "$value": "#a1123a",
          "$description": "Primary action pressed fill."
        },
        "fg": {
          "$type": "color",
          "$value": "#ff5a75",
          "$description": "Accent text, including links and ghost controls."
        }
      },
      "focus": {
        "ring": {
          "$type": "color",
          "$value": "#ff5a75",
          "$description": "Focus ring. Meets 3:1 against the canvas and surfaces."
        }
      },
      "status": {
        "danger": {
          "fg": {
            "$type": "color",
            "$value": "#ff8aa3",
            "$description": "Danger text on the canvas."
          },
          "bg": {
            "$type": "color",
            "$value": "#d70466",
            "$description": "Danger fill."
          },
          "on": {
            "$type": "color",
            "$value": "#ffffff",
            "$description": "Text on a danger fill."
          }
        },
        "success": {
          "fg": {
            "$type": "color",
            "$value": "#3ddc97",
            "$description": "Success text on the canvas."
          },
          "bg": {
            "$type": "color",
            "$value": "#3ddc97",
            "$description": "Success fill."
          },
          "on": {
            "$type": "color",
            "$value": "#121212",
            "$description": "Text on a success fill."
          }
        }
      }
    },
    "elevation": {
      "1": {
        "$type": "shadow",
        "$value": "0px 1px 2px 0px rgb(0 0 0 / 0.4)",
        "$description": "Raised control."
      },
      "2": {
        "$type": "shadow",
        "$value": "0px 6px 16px 0px rgb(0 0 0 / 0.45)",
        "$description": "Dropdown and popover."
      },
      "3": {
        "$type": "shadow",
        "$value": "0px 8px 28px 0px rgb(0 0 0 / 0.55)",
        "$description": "Dialog and overlay."
      }
    }
  }
}
